{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kouponly-web-pitch-deck",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-02",
  "d1_databases": [
    {
      "binding": "WAITLIST_DB",
      "database_name": "kouponly-waitlist",
      "database_id": "000b6efa-c4a4-49c7-a13f-d024f7def4d1",
      "migrations_dir": "./migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "WAITLIST_IP_RATE_LIMITER",
      "namespace_id": "26080601",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    {
      "name": "WAITLIST_EMAIL_RATE_LIMITER",
      "namespace_id": "26080602",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
}
